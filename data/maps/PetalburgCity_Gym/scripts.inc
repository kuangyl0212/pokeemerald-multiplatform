	setmetatile 7, 7, METATILE_PetalburgGym_RoomEntrance_Right, FALSE
	return

PetalburgCity_Gym_EventScript_SlideOpenRoomDoors::
	special PetalburgGymSlideOpenRoomDoors
	waitstate
	return

PetalburgCity_Gym_EventScript_UnlockRoomDoors::
	special PetalburgGymUnlockRoomDoors
	return

PetalburgCity_Gym_EventScript_GymGuide::
	lock
	faceplayer
	goto_if_set FLAG_DEFEATED_PETALBURG_GYM, PetalburgCity_Gym_EventScript_GymGuidePostVictory
	msgbox PetalburgCity_Gym_Text_GymGuideAdvice, MSGBOX_DEFAULT
	release
	end

PetalburgCity_Gym_EventScript_GymGuidePostVictory::
	msgbox PetalburgCity_Gym_Text_GymGuidePostVictory, MSGBOX_DEFAULT
	release
	end

PetalburgCity_Gym_EventScript_LeftGymStatue::
	lockall
	goto_if_set FLAG_BADGE05_GET, PetalburgCity_Gym_EventScript_GymStatueCertified
	goto PetalburgCity_Gym_EventScript_GymStatue
	end

PetalburgCity_Gym_EventScript_RightGymStatue::
	lockall
	goto_if_set FLAG_BADGE05_GET, PetalburgCity_Gym_EventScript_GymStatueCertified
	goto PetalburgCity_Gym_EventScript_GymStatue
	end

PetalburgCity_Gym_EventScript_GymStatueCertified::
	msgbox PetalburgCity_Gym_Text_GymStatueCertified, MSGBOX_DEFAULT
	releaseall
	end

PetalburgCity_Gym_EventScript_GymStatue::
	msgbox PetalburgCity_Gym_Text_GymStatue, MSGBOX_DEFAULT
	releaseall
	end

PetalburgCity_Gym_Text_DadYoureHereWithYourPokemon:
	.string "{CHN}爸爸：嗯？\p"
	.string "哦，这不是{PLAYER}嘛！\n"
	.string "你的搬家都搞定了？\p"
	.string "真没想到你能\n"
	.string "自己一个人到这里。\p"
	.string "哦，原来如此。\n"
	.string "你和宝可梦在一起啊。\p"
	.string "嗯……那么你是打算\n"
	.string "和我一样成为训练家了，{PLAYER}。\p"
	.string "这真是太好了！\n"
	.string "我期待你的表现！$"

PetalburgCity_Gym_Text_WallyIdLikeAPokemon:
	.string "{CHN}那个……我……\n"
	.string "我想得到一只宝可梦……$"

PetalburgCity_Gym_Text_DadOhYoureWallyRight:
	.string "{CHN}爸爸：嗯？你是……呃……哦，对了。\n"
	.string "你是小光，对吧？$"

PetalburgCity_Gym_Text_WallyIveNeverCaughtAPokemon:
	.string "{CHN}小光：我要去\n"
	.string "和茵郁市的亲戚一起住。\p"
	.string "我觉得一个人会寂寞，\n"
	.string "所以想带一只宝可梦一起去。\p"
	.string "但我以前从来没捕捉过宝可梦。\n"
	.string "我不知道怎么……$"

PetalburgCity_Gym_Text_DadHmISee:
	.string "{CHN}爸爸：嗯。我明白了。$"

PetalburgCity_Gym_Text_DadPlayerGoWithWally:
	.string "{CHN}爸爸：{PLAYER}，你听到了吧？\n"
	.string "\p"
	.string "陪小光一起去，\n"
	.string "确保他安全地捕捉到一只宝可梦。$"

PetalburgCity_Gym_Text_IllLoanYouMyZigzagoon:
	.string "{CHN}小光，给，我把宝可梦借给你。\p"
	.string "小光得到了蛇纹熊！$"

PetalburgCity_Gym_Text_WallyThankYouAndDadGivesPokeBall:
	.string "{CHN}小光：哦，哇！\n"
	.string "宝可梦！\p"
	.string "爸爸：嗯。我再给你一个精灵球。\n"
	.string "加油吧！\p"
	.string "小光得到了精灵球！$"

PetalburgCity_Gym_Text_WallyOhWowThankYou:
	.string "{CHN}小光：哦，哇！\n"
	.string "谢谢你！$"

PetalburgCity_Gym_Text_WouldYouReallyComeWithMe:
	.string "{CHN}{PLAYER}……你真的\n"
	.string "愿意陪我一起去吗？$"

PetalburgCity_Gym_Text_DadSoDidItWorkOut:
	.string "{CHN}爸爸：那么，结果怎么样？$"

PetalburgCity_Gym_Text_WallyThankYouBye:
	.string "{CHN}小光：谢谢你，是的，成功了。\n"
	.string "这是你的宝可梦，还给你。\p"
	.string "{PLAYER}，谢谢你\n"
	.string "陪我一起去。\p"
	.string "是因为有你们两个，我才能\n"
	.string "捕捉到我的宝可梦。\p"
	.string "我保证会好好\n"
	.string "照顾它的。\p"
	.string "哦！妈妈在等我，\n"
	.string "我得走了！\p"
	.string "再见，{PLAYER}！$"

PetalburgCity_Gym_Text_DadGoCollectBadges:
	.string "{CHN}爸爸：那么……\p"
	.string "{PLAYER}，如果你想成为一名\n"
	.string "强大的训练家，我的建议是这样的。\p"
	.string "前往这座城镇\n"
	.string "另一头的卡那兹市。\p"
	.string "在那里，你应该\n"
	.string "挑战道馆馆主杜鹃。\p"
	.string "之后，去其他的\n"
	.string "宝可梦道馆击败那里的馆主。\p"
	.string "从他们那里收集徽章，\n"
	.string "明白了吗？\p"
	.string "当然，我也是道馆馆主。\n"
	.string "总有一天我们会对战，{PLAYER}。\p"
	.string "不过那要等你\n"
	.string "变得更强之后。$"

PetalburgCity_Gym_Text_NormanGoToRustboro:
	.string "{CHN}爸爸：嗯？你不是要去\n"
	.string "卡那兹市的宝可梦道馆吗？\p"
	.string "和一个新手训练家对战\n"
	.string "对我来说毫无挑战性。\p"
	.string "{PLAYER}，我希望你变得\n"
	.string "更强后再来挑战我。\p"
	.string "等你拿到四枚道馆徽章，\n"
	.string "我就和你对战，好吗，{PLAYER}？$"

PetalburgCity_Gym_Text_NormanGoToDewford:
	.string "{CHN}爸爸：我明白了……所以，你击败了\n"
	.string "卡那兹市的道馆馆主。\p"
	.string "但是还有许多比你\n"
	.string "更强大的训练家，{PLAYER}。\p"
	.string "海对面的武斗镇有\n"
	.string "一位叫藤树的道馆馆主。\p"
	.string "你应该去挑战他。$"

PetalburgCity_Gym_Text_YouHaveGottenStronger:
	.string "{CHN}爸爸：嗯……{PLAYER}，你变强了\n"
	.string "\p"
	.string "从你获得的\n"
	.string "徽章数量我就能看出来。$"

PetalburgCity_Gym_Text_NormanIntro:
	.string "{CHN}爸爸：嗯……\n"
	.string "你真的拿到了四枚道馆徽章。\p"
	.string "好，按照约定，我们要进行一场\n"
	.string "宝可梦对战了。\p"
	.string "{PLAYER}……\p"
	.string "能和自己的孩子\n"
	.string "进行真正的对战，我太高兴了。\p"
	.string "但是，对战就是对战！\p"
	.string "作为道馆馆主，\n"
	.string "我会竭尽全力取胜。\p"
	.string "{PLAYER}，你也\n"
	.string "要全力以赴哦！$"

PetalburgCity_Gym_Text_NormanDefeat:
	.string "{CHN}……\p"
	.string "我……我无法……\p"
	.string "我简直不敢相信。{PLAYER}……\p"
	.string "我输给了{PLAYER}？\p"
	.string "但是，规矩就是规矩！\n"
	.string "来，拿着这个。$"

PetalburgCity_Gym_Text_ReceivedBalanceBadge:
	.string "{CHN}{PLAYER}从爸爸那里\n"
	.string "获得了平衡徽章！$"

PetalburgCity_Gym_Text_ExplainBalanceBadgeTakeThis:
	.string "{CHN}爸爸：有了那枚徽章，你所有宝可梦\n"
	.string "的防御都会提升。\p"
	.string "会秘传学习器招式冲浪的宝可梦\n"
	.string "将能在水面上移动。\p"
	.string "这是我送你的礼物。{PLAYER}，我相信\n"
	.string "你能正确使用它。$"

PetalburgCity_Gym_Text_ExplainFacade:
	.string "{CHN}爸爸：技能学习器42包含硬撑。\p"
	.string "如果宝可梦处于中毒、麻痹、\n"
	.string "或灼伤状态，\l"
	.string "招式的威力会加倍。\p"
	.string "它也许能把不利的\n"
	.string "局面转化为优势。$"

PetalburgCity_Gym_Text_DadHappyAndSad:
	.string "{CHN}爸爸：作为道馆馆主，我无法\n"
	.string "表达我有多沮丧……\p"
	.string "但作为父亲，这让我既\n"
	.string "高兴又有点难过。真奇怪……$"

PetalburgCity_Gym_Text_PleaseComeWithMe:
	.string "{CHN}啊，你在这里啊，{PLAYER}{KUN}！\p"
	.string "请跟我来。\n"
	.string "我有东西想送给你。$"

PetalburgCity_Gym_Text_LetMeBorrowPlayer:
	.string "{CHN}千里，你不介意吧？\p"
	.string "让我借你的{PLAYER}{KUN}\n"
	.string "一两分钟。$"

PetalburgCity_Gym_Text_DadGoingToKeepTraining:
	.string "{CHN}爸爸：{PLAYER}，你应该\n"
	.string "经常去看看你妈妈。\p"
	.string "我要留在这里加倍\n"
	.string "训练。\p"
	.string "作为训练家，不能向你报一败之仇，\n"
	.string "我会耿耿于怀的，{PLAYER}！$"

PetalburgCity_Gym_Text_DadNoAmountOfTrainingIsEnough:
	.string "{CHN}爸爸：{PLAYER}，最近怎么样？\p"
	.string "宝可梦的世界深不可测。\p"
	.string "我真的觉得无论多少\n"
	.string "训练都永远不够。$"

PetalburgCity_Gym_Text_GymGuideAdvice:
	.string "{CHN}嘿，最近怎么样，朝着冠军\n"
	.string "迈进的{PLAYER}？\p"
	.string "这座道馆的门在你击败\n"
	.string "等待的训练家后会打开。\p"
	.string "哎呀！这个房间的门\n"
	.string "已经打开了，所以别攻击我！\p"
	.string "橙华道馆的训练家\n"
	.string "会使用各种各样的道具。\p"
	.string "左边的门通往\n"
	.string "速度之间。\p"
	.string "右边的门通往\n"
	.string "命中之间。\p"
	.string "门上会写着房间\n"
	.string "的名字，所以请谨慎选择。\p"
	.string "一旦你选好了门……\n"
	.string "嘿，那就上吧！$"

PetalburgCity_Gym_Text_GymGuidePostVictory:
	.string "{CHN}{PLAYER}！哇！你连\n"
	.string "自己的父亲都战胜了！\p"
	.string "哇哦！\n"
	.string "真是令人震惊的结果！$"

PetalburgCity_Gym_Text_RandallIntro:
	.string "{CHN}比对手先攻击\n"
	.string "的能力……\p"
	.string "光是这一点就让我处于\n"
	.string "巨大的优势，你不觉得吗？$"

PetalburgCity_Gym_Text_RandallDefeat:
	.string "{CHN}那是一场精彩的对战！$"

PetalburgCity_Gym_Text_RandallPostBattle:
	.string "{CHN}继续前往下一个房间吧，\n"
	.string "那里有新的挑战等着你。\p"
	.string "左边是混乱之间。\p"
	.string "右边的门通往防御\n"
	.string "之间。$"

PetalburgCity_Gym_Text_RandallPostBadge:
	.string "{CHN}无论你战胜谁，\n"
	.string "也无论你输给谁，你从不逃避\l"
	.string "训练自己和宝可梦。\p"
	.string "我觉得这才是\n"
	.string "道馆馆主的真正含义。$"

PetalburgCity_Gym_Text_ParkerIntro:
	.string "{CHN}这里是混乱之间。\p"
	.string "让我看看你和你的宝可梦\n"
	.string "之间的羁绊有多深！$"

PetalburgCity_Gym_Text_ParkerDefeat:
	.string "{CHN}我没能让你的队伍混乱到极点……\n"
	.string "你们之间的羁绊很深。$"

PetalburgCity_Gym_Text_ParkerPostBattle:
	.string "{CHN}下一个房间是力量之间。\n"
	.string "你能承受蛮力攻击吗？$"

PetalburgCity_Gym_Text_ParkerPostBadge:
	.string "{CHN}自从你打败了我们馆主之后，\n"
	.string "训练变得严格多了。$"

PetalburgCity_Gym_Text_GeorgeIntro:
	.string "{CHN}就在你以为要赢的时候，\n"
	.string "对手却恢复了HP……\p"
	.string "你能想象那是\n"
	.string "多么糟糕的感觉吗？\p"
	.string "我这就让你体验\n"
	.string "那种糟糕的感觉！$"

PetalburgCity_Gym_Text_GeorgeDefeat:
	.string "{CHN}我没恢复够HP……\n"
	.string "好厉害的攻击力……$"

PetalburgCity_Gym_Text_GeorgePostBattle:
	.string "{CHN}不愧是\n"
	.string "我们馆主的孩子。\p"
	.string "不，等等！训练家的能力\n"
	.string "只有通过努力才能获得。\p"
	.string "我输了是因为我自己的努力\n"
	.string "还不够。\p"
	.string "去吧！接下来是一击必杀之间。$"

PetalburgCity_Gym_Text_GeorgePostBadge:
	.string "{CHN}我要继续在道馆训练。\n"
	.string "总有一天，我要成为馆主。$"

PetalburgCity_Gym_Text_BerkeIntro:
	.string "{CHN}我不会因为你是我们馆主的孩子\n"
	.string "就手软。\p"
	.string "我要让你看看宝可梦受到\n"
	.string "要害攻击时有多痛苦！$"

PetalburgCity_Gym_Text_BerkeDefeat:
	.string "{CHN}你的力量……\n"
	.string "你确实是有真本事。$"

PetalburgCity_Gym_Text_BerkePostBattle:
	.string "{CHN}你父亲真的很强。\n"
	.string "他是一位值得我尊敬的训练家。\p"
	.string "而且，我从你身上\n"
	.string "感受到了和你父亲一样的光辉。\p"
	.string "希望你能和你父亲\n"
	.string "上演一场精彩的对战！$"

PetalburgCity_Gym_Text_BerkePostBadge:
	.string "{CHN}自从你爸爸成为馆主以来，\n"
	.string "橙华市的训练家\l"
	.string "都变强了不少。$"

PetalburgCity_Gym_Text_MaryIntro:
	.string "{CHN}咯咯……\n"
	.string "这里是命中之间。\p"
	.string "每次攻击都\n"
	.string "命中无误可是相当厉害的。$"

PetalburgCity_Gym_Text_MaryDefeat:
	.string "{CHN}你比我更胜一筹……$"

PetalburgCity_Gym_Text_MaryPostBattle:
	.string "{CHN}还有更强的\n"
	.string "训练家在等你。\p"
	.string "左边是防御之间，\n"
	.string "右边是回复之间。\p"
	.string "无论选哪个，\n"
	.string "你的宝可梦的攻击力都会受到考验。$"

PetalburgCity_Gym_Text_MaryPostBadge:
	.string "{CHN}你知道我们作为训练家\n"
	.string "在追求什么吗？\p"
	.string "我们在努力和\n"
	.string "宝可梦成为灵魂伴侣。$"

PetalburgCity_Gym_Text_AlexiaIntro:
	.string "{CHN}防御越高，\n"
	.string "我在攻击时就越能肆无忌惮。$"

PetalburgCity_Gym_Text_AlexiaDefeat:
	.string "{CHN}我们的防御还不够……$"

PetalburgCity_Gym_Text_AlexiaPostBattle:
	.string "{CHN}你在这里给我上了\n"
	.string "宝贵的一课。\p"
	.string "好了，去吧！左边的门通往\n"
	.string "力量之间。\p"
	.string "右边的门通往\n"
	.string "一击必杀之间。\p"
	.string "那里都有擅长\n"
	.string "攻击的训练家。$"

PetalburgCity_Gym_Text_AlexiaPostBadge:
	.string "{CHN}嗨！你试过用冲浪吗？$"

PetalburgCity_Gym_Text_JodyIntro:
	.string "{CHN}我们的道馆馆主要我们全力以赴\n"
	.string "击败你。\p"
	.string "即使你\n"
	.string "是馆主的孩子！$"

PetalburgCity_Gym_Text_JodyDefeat:
	.string "{CHN}可是……我已经全力以赴了！$"

PetalburgCity_Gym_Text_JodyPostBattle:
	.string "{CHN}你操控宝可梦的方式……\n"
	.string "和你父亲的风格很像。\p"
	.string "继续前进吧！道馆馆主，\n"
	.string "你的父亲在等你！$"

PetalburgCity_Gym_Text_JodyPostBadge:
	.string "{CHN}当然，让你的宝可梦\n"
	.string "变强是好的。\p"
	.string "但是什么决定了胜负？\p"
	.string "那就是训练家对\n"
	.string "宝可梦的感情。$"

PetalburgCity_Gym_Text_DoorAppearsLocked:
	.string "{CHN}这扇门现在\n"
	.string "似乎是锁着的……$"

PetalburgCity_Gym_Text_EnterSpeedRoom:
	.string "{CHN}牌子上写着速度之间。\p"
	.string "你要进去吗？$"

/* Unused*/
PetalburgCity_Gym_Text_DoorAppearsLocked2:
	.string "{CHN}这扇门现在\n"
	.string "似乎是锁着的……$"

PetalburgCity_Gym_Text_EnterAccuracyRoom:
	.string "{CHN}牌子上写着命中之间。\p"
	.string "你要进去吗？$"

PetalburgCity_Gym_Text_EnterConfusionRoom:
	.string "{CHN}牌子上写着混乱之间。\p"
	.string "你要进去吗？$"

PetalburgCity_Gym_Text_EnterDefenseRoom:
	.string "{CHN}牌子上写着防御之间。\p"
	.string "你要进去吗？$"

PetalburgCity_Gym_Text_EnterRecoveryRoom:
	.string "{CHN}牌子上写着回复之间。\p"
	.string "你要进去吗？$"

PetalburgCity_Gym_Text_EnterStrengthRoom:
	.string "{CHN}牌子上写着力量之间。\p"
	.string "你要进去吗？$"

PetalburgCity_Gym_Text_EnterOHKORoom:
	.string "{CHN}牌子上写着一击必杀之间。\p"
	.string "你要进去吗？$"

PetalburgCity_Gym_Text_EnterGymLeadersRoom:
	.string "{CHN}“馆主之间\p"
	.string "“亲眼看看有什么宝可梦\n"
	.string "在等你吧！”牌子上写着。\p"
	.string "你要进去吗？$"

PetalburgCity_Gym_Text_GymStatue:
	.string "{CHN}橙华市宝可梦道馆$"

PetalburgCity_Gym_Text_GymStatueCertified:
	.string "{CHN}橙华市宝可梦道馆\p"
	.string "千里的认证训练家：\n"
	.string "{PLAYER}$"

PetalburgCity_Gym_Text_NormanPreRematch:
	.string "{CHN}爸爸：{PLAYER}……\n"
	.string "我就知道你会来。\p"
	.string "我绝不会拒绝\n"
	.string "你的挑战。\p"
	.string "你明白的，对吧？\p"
	.string "在道馆里，\n"
	.string "我们是父母和孩子的身份并不重要。\p"
	.string "……不，正因为我们\n"
	.string "是父母和孩子，\l"
	.string "我们才更应该全力以赴。不是吗，{PLAYER}？$"

PetalburgCity_Gym_Text_NormanRematchDefeat:
	.string "{CHN}呃……哈哈……\n"
	.string "也许我下手太重了……$"

PetalburgCity_Gym_Text_NormanPostRematch:
	.string "{CHN}爸爸：{PLAYER}……\n"
	.string "你的梦想是什么？\p"
	.string "我的梦想……\n"
	.string "哈哈哈……\l"
